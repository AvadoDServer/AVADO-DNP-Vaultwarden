# HTTPS front for Vaultwarden (generated for this package; app on 127.0.0.1:8080)
user __NGINX_USER__;
worker_processes 2;
pid /tmp/avado-nginx/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 1024;
}

http {
  access_log off;
  server_tokens off;
  default_type application/octet-stream;
  client_body_temp_path /tmp/avado-nginx/body;
  proxy_temp_path /tmp/avado-nginx/proxy;
  fastcgi_temp_path /tmp/avado-nginx/fastcgi;
  uwsgi_temp_path /tmp/avado-nginx/uwsgi;
  scgi_temp_path /tmp/avado-nginx/scgi;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  ssl_certificate     /etc/avado/certs/live.crt;
  ssl_certificate_key /etc/avado/certs/live.key;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_cache   shared:avado:2m;

  # Vaultwarden needs a secure page (the browser's crypto functions only work over HTTPS).
  server {
    listen 80 default_server;
    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl default_server;
    client_max_body_size 525m;
    location / {
      proxy_pass http://127.0.0.1:8080;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
    }
  }
}
